<?xml version="1.0" encoding="UTF-8"?>
<!-- Blir inkludert frå logback-spring.xml når app.logger.enableLogstash=true -->
<included>
    <appender name="stash" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <droppedWarnFrequency>5</droppedWarnFrequency>
        <destination>${destination}</destination>
        <!--
            Felta i customFields kjem frå <springProperty> i logback-spring.xml. server fell tilbake på
            logback sitt eige HOSTNAME når miljøvariabelen HOSTNAME ikkje er sett (til dømes på Windows).
        -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>
                {"appname":"${artifactId}","buildinfo.version":"${version}","buildinfo.lastcommit":"${buildNumber}","orgnr":"${orgnr}","server":"${serverName:-${HOSTNAME}}"}
            </customFields>
            <fieldNames>
                <!-- Ignore message and stackTrace field here due to possible sensitive data (personal identity number), replaced in pattern below. -->
                <message>[ignore]</message>
                <stackTrace>[ignore]</stackTrace>
            </fieldNames>
            <provider class="net.logstash.logback.composite.loggingevent.LoggingEventPatternJsonProvider">
                <pattern>
                    {
                    "message": "%replace(%msg){'[0-9]{11}','**********'}",
                    "stack_trace": "%replace(%ex{full}){'[0-9]{11}','**********'}"
                    }
                </pattern>
            </provider>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="stash"/>
    </root>
</included>
