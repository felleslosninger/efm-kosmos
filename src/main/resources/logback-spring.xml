<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>
    <springProperty name="stdoutAppender" source="app.logger.stdoutAppender"/>
    <springProperty name="destination" source="app.logger.destination"/>
    <springProperty name="profiles" source="spring.profiles.active"/>
    <springProperty name="enableLogstash" source="app.logger.enableLogstash" defaultValue="false"/>
    <springProperty scope="context" name="serverName" source="HOSTNAME" />

    <!--
        Logstash-appenderen blir berre lasta når app.logger.enableLogstash=true, sidan det berre finst
        ei logback-logstash-true.xml. Vi brukar ikkje <if>: condition-attributtet krev janino, og logback 1.5.38
        evaluerer det ikkje lenger, så Logstash vart aldri slått på.
    -->
    <include resource="logback-logstash-${enableLogstash}.xml" optional="true"/>

    <root level="INFO">
        <appender-ref ref="${stdoutAppender:-CONSOLE}"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
